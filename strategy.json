[
  {
    "name_en": ">>> Universal (Recommended)",
    "name_ru": ">>> Универсальная (Рекомендуется)",
    "args": "-d1 -s1+s -d1+s -s3+s -d6+s -s12+s -d14+s -s20+s -d24+s -s30+s -a1",
    "domains": "googlevideo.com, youtube.com, youtu.be, youtubei.googleapis.com, ytimg.com"
  },
  {
    "name_en": ">>> Lightweight, consumes fewer resources",
    "name_ru": ">>> Легкая, тратит меньше ресурсов",
    "args": "-o1 -r-5+se -a1",
    "domains": "googlevideo.com, youtube.com, youtu.be, youtubei.googleapis.com, ytimg.com"
  },
  {
    "name_en": ">>> Fallback strategy with fake SNI",
    "name_ru": ">>> Запасная стратегия с фейк SNI",
    "args": "-o1 -r-5+se -a1 -At,r,s -d1 -n \"google.com\" -Qr -f-1 -a1",
    "domains": "googlevideo.com, youtube.com, youtu.be, youtubei.googleapis.com, ytimg.com"
  }
]
